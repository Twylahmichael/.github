# ---------- App (browser-safe; VITE_ vars are bundled into the client) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public URL of the site. Used for CORS in edge functions and links in WhatsApp messages.
SITE_URL=http://localhost:3000
BUSINESS_NAME=Your BNB Brand
# Owner contact shown to guests (2547XXXXXXXX). Also editable in Admin > Settings
SUPPORT_WHATSAPP=2547XXXXXXXX
# Extra browser origins allowed to call edge functions (comma separated). SITE_URL is always allowed
ALLOWED_ORIGINS=
# Owner contact shown to guests (2547XXXXXXXX)
SUPPORT_WHATSAPP=2547XXXXXXXX
# Public Paybill / Till shown as the manual-payment fallback on the guest payment screen
VITE_MPESA_PAYBILL_DISPLAY=
# Optional: call edge functions somewhere else (e.g. `npm run dev:functions` -> http://127.0.0.1:54331/functions/v1)
VITE_FUNCTIONS_URL=

# ---------- Supabase (Edge Functions + scripts ONLY. NEVER exposed to the browser) ----------
# Set with: supabase secrets set KEY=value   (and in your shell for scripts/*.mjs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- M-Pesa Daraja ----------
# mock = no credentials needed, fake STK push that self-confirms after ~4s
# sandbox | production = real Daraja
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TXN_TYPE=CustomerPayBillOnline
# For BuyGoods the PartyB is the Till number (leave empty to reuse MPESA_SHORTCODE)
MPESA_PARTY_B=
# Random 32+ char string, appended to the callback URL as ?token=
MPESA_CALLBACK_SECRET=
# Mock only: when true, amounts ending in 13 fail (demo the failure UI)
MPESA_MOCK_FAIL_ON_13=true
# Only if the public URL of the functions differs from SUPABASE_URL (local tunnels, `npm run dev:functions`)
MPESA_CALLBACK_BASE_URL=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: verifies Meta's X-Hub-Signature-256 on the webhook
WHATSAPP_APP_SECRET=
# true = send approved templates (bnb_booking_confirmed ...) instead of session text. See DEPLOY.md
WHATSAPP_USE_TEMPLATES=false
# Shown in messages as the manual-payment fallback (also editable in Admin > Settings)
MPESA_PAYBILL_DISPLAY=

# ---------- Scripts only ----------
# Used by `npm run create-owner`
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
# Used by `npm run seed:users` (never commit a real value)
DEMO_PASSWORD=
# Direct Postgres URL for `npm run seed` / `npm run test:sql` (local: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=
